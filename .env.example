# Copy to .env beside the executable and configure corporate HTTPS URLs.
GELITA_CITRIX_BR_DISCOVERY_URL=
GELITA_CITRIX_EB_DISCOVERY_URL=

# Inventory reporting: HTTPS portal root and the same key configured on the server.
# Empty values disable reporting. Keep real keys out of source control.
GELITA_TOOLKIT_PORTAL_URL=
GELITA_TOOLKIT_AGENT_KEY=
# Optional physical unit; do not infer it from the printer selection or Snow site.
GELITA_TOOLKIT_UNIT=
