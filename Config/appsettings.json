{
  "application": {
    "name": "Gelita Printer & Scanner Installer",
    "version": "1.0.0",
    "company": "Gelita AG",
    "department": "Service Desk",
    "description": "Ferramenta interna para automatizar instalação de impressoras, Epson Scan 2, NAPS e configuração de scanners"
  },
  "logging": {
    "enableLogging": true,
    "logLevel": "Info",
    "logPath": "./Logs",
    "maxLogFileSize": 10485760,
    "maxLogFiles": 5
  },
  "paths": {
    "assetsPath": "./Assets",
    "configPath": "./Config",
    "logsPath": "./Logs",
    "epsonScan2Path": "./Assets/EpsonScan2",
    "napsPath": "./Assets/NAPS",
    "driversPath": "./Assets/Drivers"
  },
  "settings": {
    "autoDetectPrinters": true,
    "autoDetectScanners": true,
    "requireAdminPrivileges": true,
    "allowRemoteInstallation": false,
    "installationTimeout": 300000,
    "retryAttempts": 3
  }
}
