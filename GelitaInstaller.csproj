<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    
    <!-- Informações da Aplicação -->
    <AssemblyName>GelitaInstaller</AssemblyName>
    <RootNamespace>GelitaInstaller</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Gelita AG - Service Desk</Authors>
    <Description>Ferramenta interna para automatizar a instalação de impressoras, Epson Scan 2, NAPS e configuração de scanners Epson.</Description>
    <Product>Gelita Printer &amp; Scanner Installer</Product>
    <Company>Gelita AG</Company>
    <Title>Gelita Printer &amp; Scanner Installer</Title>
    
    <!-- Configurações de Build -->
    <StartupObject>GelitaInstaller.Program</StartupObject>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!-- Dependências do Projeto -->
  <ItemGroup>
    <!-- JSON Support -->
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
    
    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    
    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <!-- Recursos Embed -->
  <ItemGroup>
    <None Update="Config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
